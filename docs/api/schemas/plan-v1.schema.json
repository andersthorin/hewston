{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hewston.app/schemas/plan-v1.schema.json",
  "title": "Agentic Plan (v1)",
  "type": "object",
  "required": ["version", "from", "to", "universe", "strategies", "guardrails", "plan_hash"],
  "properties": {
    "version": {"const": "1"},
    "from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "to": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "universe": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z0-9_.-]+$"}},
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "reason"],
            "properties": {
              "symbol": {"type": "string"},
              "reason": {"type": "string", "enum": [
                "COVERAGE_LOW", "NO_DATA", "INVALID_INSTRUMENT", "GUARDRAIL_FAIL", "OTHER"
              ]},
              "details": {"type": "object", "additionalProperties": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "params"],
        "properties": {
          "id": {"type": "string"},
          "params": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "guardrails": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "ok"],
            "properties": {
              "name": {"type": "string", "enum": [
                "coverage", "min_trades", "turnover", "max_drawdown", "no_nans"
              ]},
              "ok": {"type": "boolean"},
              "details": {"type": "object", "additionalProperties": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "plan_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "notes": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

