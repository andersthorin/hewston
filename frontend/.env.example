# Frontend Environment Configuration
# Copy this file to .env.local and customize as needed

# BFF Feature Flags - Control BFF vs Backend endpoint selection
# All flags default to false for safety (direct backend behavior)

# Master toggle for BFF usage
VITE_BFF_ENABLED=false

# Granular endpoint control
VITE_BFF_CHART_DATA_ENABLED=false
VITE_BFF_RUN_DATA_ENABLED=false
VITE_BFF_WEBSOCKET_ENABLED=false

# API Base URLs
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_BFF_BASE_URL=http://127.0.0.1:8001
VITE_WS_BASE_URL=ws://127.0.0.1:8000
VITE_BFF_WS_BASE_URL=ws://127.0.0.1:8001

# Development Tools
VITE_FEATURE_FLAG_DEBUG=true
